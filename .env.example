# .env holds the encryption key (required) and optional starting values. Values saved in
# Settings always win over the optional ones. To use those, also uncomment `env_file: .env`
# in docker-compose.yml.

# --- Required ---------------------------------------------------------------------
# The key that encrypts your data on disk. Create one with:
#   echo "DAYSCORE_KEY=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')" >> .env
# Keep a copy in your password manager: without it your data can't be opened.
DAYSCORE_KEY=

# --- Can also be set in Settings ------------------------------------------------
# anthropic, openrouter or local
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Your own OpenAI-compatible server, e.g. Ollama
LOCAL_AI_URL=
LOCAL_AI_MODEL=
TELEGRAM_BOT_TOKEN=
TODOIST_API_TOKEN=
# comma-separated Todoist project IDs
TODOIST_PROJECTS=
# Your time zone, e.g. Europe/Berlin (can also be set in Settings)
TZ=UTC
LATE_ENTRY_UNTIL=12:00
# Workdays as numbers, Monday = 0 (can also be set in Settings)
WORKDAYS=0,1,2,3,4
MORNING_REMINDER=09:00
EVENING_REMINDER=21:30

# --- Server-only options -------------------------------------------------------
# A fixed password instead of creating one in the browser (then it can't be changed there).
APP_PASSWORD=
# true when the site is served over HTTPS (reverse proxy, Cloudflare, Tailscale Serve).
SECURE_COOKIES=false
# Your reverse proxy's address, so failed logins are counted per visitor.
#FORWARDED_ALLOW_IPS=172.18.0.1
# Port on your server
#DAYSCORE_PORT=8000
# Only if the site is reachable exclusively through Tailscale/VPN and you want no password.
DISABLE_AUTH=false
APP_NAME=DayScore
# Color theme: orchid (violet/pink, default) or green (handy for a test environment)
APP_ACCENT=orchid
