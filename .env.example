# OPTIONAL. You don't need this file: open the web page, create a password and set
# everything else up in Settings. Values saved in Settings always win over these.
# To use it: copy to .env and uncomment `env_file: .env` in docker-compose.yml.

# --- Can also be set in Settings ------------------------------------------------
# anthropic or openrouter
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
TELEGRAM_BOT_TOKEN=
TODOIST_API_TOKEN=
# comma-separated Todoist project IDs
TODOIST_PROJECTS=
# Your time zone, e.g. Europe/Berlin (can also be set in Settings)
TZ=UTC
LATE_ENTRY_UNTIL=12:00
# Workdays as numbers, Monday = 0 (can also be set in Settings)
WORKDAYS=0,1,2,3,4
MORNING_REMINDER=09:00
EVENING_REMINDER=21:30

# --- Server-only options -------------------------------------------------------
# A fixed password instead of creating one in the browser (then it can't be changed there).
APP_PASSWORD=
# true when the site is served over HTTPS (reverse proxy, Cloudflare, Tailscale Serve).
SECURE_COOKIES=false
# Only if the site is reachable exclusively through Tailscale/VPN and you want no password.
DISABLE_AUTH=false
APP_NAME=DayScore
